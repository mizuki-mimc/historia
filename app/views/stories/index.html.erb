<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="max-w-screen-xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tighter border-l-8 border-black mt-8 mb-8 pl-4">ストーリー</h1>
    </div>

    <div class="mb-12">
      <%= search_form_for @q, url: stories_path, method: :get, data: { turbo: false } do |f| %>
        <div class="flex flex-col sm:flex-row items-center space-y-4 sm:space-y-0 sm:space-x-4">
          <%= f.search_field :title_cont, class: "form-input w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "タイトルを検索" %>
          <button type="submit" class="flex-shrink-0 px-6 py-2 bg-black text-white rounded-md font-semibold hover:bg-gray-800 transition duration-300">
            検索
          </button>
        </div>
      <% end %>
    </div>

    <% if @stories.empty? %>
      <div class="text-center py-20 border-2 border-dashed rounded-lg bg-gray-50">
        <h2 class="text-xl font-semibold text-gray-700">まだストーリーはありません</h2>
        <p class="mt-2 text-gray-500">ヘッダーの「ストーリー作成」ボタンから、あなたの最初の物語を始めましょう！</p>
      </div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-16">
        <%= render @stories %>
      </div>
    <% end %>
  </div>
</div>
